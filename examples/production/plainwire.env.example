# Plainwire 2.0 production baseline
PLAINWIRE_ENV=production
PLAINWIRE_PUBLIC_URL=https://chat.example.com
# Used by the included Caddy service. Hostname only, no scheme.
PLAINWIRE_HOST=chat.example.com
# Image built from the matching upstream Plainwire source.
PLAINWIRE_IMAGE=ghcr.io/example/plainwire:2.0.0
COOKIE_SECURE=true
PLAINWIRE_TRUST_PROXY=true
PLAINWIRE_TRUSTED_PROXIES=172.30.0.0/24

PLAINWIRE_APP_NAME=Plainwire
PLAINWIRE_REGISTRATION_ENABLED=true
PLAINWIRE_INSTANCE_DESCRIPTION="A self-hosted Plainwire instance."

PLAINWIRE_DB_HOST=db
PLAINWIRE_DB_PORT=5432
PLAINWIRE_DB_USER=plainwire
PLAINWIRE_DB_PASS=CHANGE_ME_DB_PASSWORD
PLAINWIRE_DB_NAME=plainwire
# The Compose example uses a private container network. Enable DB TLS when the
# database crosses an untrusted or shared network.
PLAINWIRE_DB_SSL=false
PLAINWIRE_ALLOW_INSECURE_DB=true
PLAINWIRE_DB_POOL_SIZE=20

PLAINWIRE_ENC_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
PLAINWIRE_PBKDF2_ITERS=160000

PLAINWIRE_UPLOAD_DIR=/var/lib/plainwire/uploads
PLAINWIRE_UPLOAD_MAX_BYTES=262144000
PLAINWIRE_UPLOAD_QUOTA_BYTES=1073741824
PLAINWIRE_UPLOAD_RETENTION_DAYS=90

PLAINWIRE_REDIS_ENABLED=true
PLAINWIRE_REDIS_HOST=redis
PLAINWIRE_REDIS_PORT=6379
PLAINWIRE_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
PLAINWIRE_REDIS_DB=0
PLAINWIRE_REDIS_PREFIX=plainwire
PLAINWIRE_REDIS_TIMEOUT_MS=80

# Safe default. Add Scylla later through the migration guide.
PLAINWIRE_MESSAGE_BACKEND=postgres
PLAINWIRE_SCYLLA_ENABLED=false
PLAINWIRE_SCYLLA_CONTACT_POINTS=scylla
PLAINWIRE_SCYLLA_PORT=9042
PLAINWIRE_SCYLLA_KEYSPACE=plainwire
PLAINWIRE_SCYLLA_LOCAL_DC=datacenter1
PLAINWIRE_SCYLLA_CONSISTENCY=local_quorum

# Choose Cloudflare TURN or coturn below. Do not configure both unless you
# intentionally want Cloudflare to take priority.
PLAINWIRE_REQUIRE_TURN=true
PLAINWIRE_TURN_TTL_SECONDS=3600
PLAINWIRE_ICE_TRANSPORT_POLICY=all

# coturn shared-secret mode
PLAINWIRE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PLAINWIRE_TURN_SECRET=CHANGE_ME_TURN_SECRET_AT_LEAST_32_BYTES
PLAINWIRE_TURN_USERNAME=plainwire

# Cloudflare Realtime TURN alternative
PLAINWIRE_CF_TURN_KEY_ID=
PLAINWIRE_CF_TURN_API_TOKEN=

# Optional host admin plane. Keep disabled until you intentionally deploy it.
PLAINWIRE_ADMIN_ENABLED=false
PLAINWIRE_ADMIN_BIND=127.0.0.1
PLAINWIRE_ADMIN_PORT=8090
PLAINWIRE_ADMIN_ALLOW_REMOTE=false
PLAINWIRE_ADMIN_SECRET_FILE=/var/lib/plainwire/admin-instance.key

ERL_FLAGS=+S auto +A 64 +P 2000000 +sbwt very_short +sbwtdcpu very_short +sbwtdio short
PORT=8080
