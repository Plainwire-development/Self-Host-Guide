# Set PLAINWIRE_HOST in Caddy's environment, for example chat.example.com.
{$PLAINWIRE_HOST} {
    encode zstd gzip

    @uploads path /api/uploads*
    request_body @uploads {
        max_size 250MB
    }

    @ordinary not path /api/uploads*
    request_body @ordinary {
        max_size 25MB
    }

    reverse_proxy app:8080 {
        health_uri /api/health
        health_interval 30s
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
